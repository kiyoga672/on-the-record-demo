# Shared by Python and Next.js. Copy this file to .env in this directory.
ES_URL=
KIBANA_URL=
# Elasticsearch API key: Encoded value, NOT an Elastic Cloud organization API key.
ES_API_KEY=
ES_VERSION=
OPENAUSTRALIA_KEY=
BEDROCK_CONNECTOR_ID=
BEDROCK_INFERENCE_ID=
EMAIL_CONNECTOR_ID=
AGENT_ID=on-the-record
AWS_REGION=ap-southeast-2
JINA_API_KEY=
RERANK_INFERENCE_ID=.rerank-v1-elasticsearch
S3_RAW_BUCKET=
INGEST_FUNCTION_URL=
INGEST_FUNCTION_TOKEN=
# Filled by elastic/setup.py after successfully registering Workflows.
FIND_MY_MP_WORKFLOW_ID=
FOLLOW_TOPIC_WORKFLOW_ID=
DAILY_HANSARD_WORKFLOW_ID=
EXPORT_FACTSHEET_WORKFLOW_ID=
# Use a Bedrock model ID available in your AWS account for the optional eval judge.
BEDROCK_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# Optional public UI default, an example date only (not an election forecast).
NEXT_PUBLIC_REMINDER_DEFAULT=2028-04-01
SAVE_QUOTE_WORKFLOW_ID=otr-save-quote
REMINDER_DIGEST_WORKFLOW_ID=otr-reminder-digest
# Canonical public site origin after deployment; local preview can leave blank.
SITE_URL=
